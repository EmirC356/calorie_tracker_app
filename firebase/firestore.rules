rules_version = '2';

// Firestore security rules for the Squad Accountability feature.
// Only daily aggregated snapshots live in the cloud — raw meals/exercises/
// weight stay on-device. Grows by phase; this covers Phases 1–5.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    // Current squad doc data (used by subcollection rules).
    function squadData(squadId) {
      return get(/databases/$(database)/documents/squads/$(squadId)).data;
    }
    function isMemberOf(squadId) {
      return isSignedIn() && uid() in squadData(squadId).memberUids;
    }
    function isOwnerOf(squadId) {
      return isSignedIn() && uid() == squadData(squadId).ownerUid;
    }
    function isMember(squadId, u) {
      return u in squadData(squadId).memberUids;
    }
    // A pause object is bounded: a window of at most 21 days and a yearly tally
    // of at most 60 days. windowDays is denormalized so we needn't parse `until`.
    function isValidPause(p) {
      return p.windowDays is int
        && p.windowDays >= 0
        && p.windowDays <= 21
        && p.daysUsedThisYear is int
        && p.daysUsedThisYear >= 0
        && p.daysUsedThisYear <= 60;
    }

    // ── users/{uid} ───────────────────────────────────────────────────────────
    // A signed-in user reads/writes ONLY their own profile. No deletes.
    match /users/{userId} {
      allow read: if isSignedIn() && uid() == userId;
      allow create, update: if isSignedIn() && uid() == userId;
      allow delete: if false;

      // ── users/{uid}/goalsVisible/{occId}: squad-visible goal occurrences ─────
      // Owner writes; squadmates read. Read access is gated by the denormalized
      // `readerUids` (the union of memberUids across the owner's squads) rather
      // than a per-squad membership get() — that keeps the rule O(1) AND lets a
      // squadmate run `where readerUids array-contains me` (request.auth.uid is
      // inlined so the query analyzer matches the filter). Trade-off: readerUids
      // is recomputed on every snapshot push; a removed squadmate keeps read
      // access only until the next push refreshes the doc.
      match /goalsVisible/{occId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId
              || request.auth.uid in resource.data.readerUids);
        allow write: if isSignedIn() && uid() == userId;
      }

      // ── Notification queue (Phase 8): the device writes the morning brief and
      // pending reminders so the Cloud Functions can read + send them. Private
      // to the owner; the functions use the admin SDK (which bypasses rules).
      match /todaysGoalsBrief/{date} {
        allow read, write: if isSignedIn() && uid() == userId;
      }
      match /pendingReminders/{occId} {
        allow read, write: if isSignedIn() && uid() == userId;
      }

      // ── Weekly retro (Sunday recap): written ONLY by Cloud Functions (admin
      // SDK bypasses rules); readable by the owner. pendingRetroPush is an
      // internal function queue — no client access.
      match /weeklyRetros/{weekKey} {
        allow read: if isSignedIn() && uid() == userId;
        allow write: if false;
      }
      match /pendingRetroPush/{weekKey} {
        allow read, write: if false;
      }
    }

    // ── squadCodes/{code} ─────────────────────────────────────────────────────
    // code -> { squadId, expiresAt }. Lets a non-member resolve an invite code
    // to a squad (squad docs are member-only). get-only (never listable, so
    // codes can't be enumerated). Written only by the target squad's owner —
    // prevents an attacker from minting a code that points at someone else's
    // squad. (Owner check uses get(), so on squad creation the squad doc must
    // be written BEFORE its code doc; the service does exactly that.)
    match /squadCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isSignedIn()
        && squadData(request.resource.data.squadId).ownerUid == uid();
      allow delete: if isSignedIn()
        && squadData(resource.data.squadId).ownerUid == uid();
    }

    // ── squads/{squadId} ──────────────────────────────────────────────────────
    match /squads/{squadId} {
      // Read: members only. NOTE: request.auth.uid is inlined (not the uid()
      // helper) so the query-rules analyzer can match it against the
      // `memberUids array-contains <uid>` filter used by "my squads"; behind a
      // helper, list queries get denied.
      allow read: if request.auth != null && request.auth.uid in resource.data.memberUids;

      // Create: the creator is the owner and the sole member.
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.memberUids == [uid()]
        && request.resource.data.memberUids.size() <= 10
        && request.resource.data.name is string
        && request.resource.data.inviteCode is string;

      // Update: the OWNER may change anything (rename, kick via memberUids,
      // transfer ownership) — OR a non-member may JOIN by adding only
      // themselves to memberUids, with a non-expired code and every other
      // field unchanged. Cap enforced at <= 10 either way.
      allow update: if isSignedIn()
        && request.resource.data.memberUids.size() <= 10
        && (
          resource.data.ownerUid == uid()
          || (
            // JOIN: a non-member adds only themselves, code not expired.
            !(uid() in resource.data.memberUids)
            && uid() in request.resource.data.memberUids
            && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
            && request.resource.data.memberUids.hasAll(resource.data.memberUids)
            && request.resource.data.name == resource.data.name
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.inviteCode == resource.data.inviteCode
            && request.resource.data.inviteCodeExpiresAt == resource.data.inviteCodeExpiresAt
            && request.time < resource.data.inviteCodeExpiresAt
          )
          || (
            // LEAVE: a non-owner member removes only themselves.
            resource.data.ownerUid != uid()
            && uid() in resource.data.memberUids
            && !(uid() in request.resource.data.memberUids)
            && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
            && resource.data.memberUids.hasAll(request.resource.data.memberUids)
            && request.resource.data.name == resource.data.name
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.inviteCode == resource.data.inviteCode
          )
        );

      // Delete: owner only.
      allow delete: if isSignedIn() && resource.data.ownerUid == uid();

      // ── members/{uid}: per-squad goal + sharing level ───────────────────────
      match /members/{memberUid} {
        allow read: if isMemberOf(squadId);
        // Write only your OWN member doc; sharingLevel must be in the enum.
        // A `pause` object (if present) is bounded: window ≤ 21 days and the
        // yearly tally ≤ 60 days (the rest of the window is validated client-side
        // / Dart-tested in SquadPause.planPause).
        allow create, update: if isSignedIn()
          && uid() == memberUid
          && request.resource.data.sharingLevel in ['status', 'totals', 'full']
          && (!('pause' in request.resource.data) || isValidPause(request.resource.data.pause));
        // Leave (self) or owner-kick.
        allow delete: if isSignedIn() && (uid() == memberUid || isOwnerOf(squadId));
      }

      // ── days/{date}/entries/{uid}: daily snapshots ──────────────────────────
      match /days/{date}/entries/{entryUid} {
        allow read: if isMemberOf(squadId);
        // Write only your OWN entry.
        allow write: if isSignedIn() && uid() == entryUid && isMemberOf(squadId);
      }

      // ── days/{date}/reactions/{id} ──────────────────────────────────────────
      match /days/{date}/reactions/{reactionId} {
        allow read: if isMemberOf(squadId);
        allow create: if isSignedIn()
          && isMemberOf(squadId)
          && request.resource.data.fromUid == uid()
          && request.resource.data.toUid != uid(); // no nudging yourself
        allow update: if false; // reactions are immutable
        allow delete: if isSignedIn() && resource.data.fromUid == uid();
      }

      // ── days/{date}/comments/{id}: words on a member's day ──────────────────
      // Self-from, recipient must be a member, ≤200 chars, ≤5 per (from,to,day)
      // — the count is validated via the same-batch counter (getAfter). Edits +
      // soft-deletes are author-only (the 5-min edit window is client-side).
      match /days/{date}/comments/{commentId} {
        allow read: if isMemberOf(squadId);
        allow create: if isMemberOf(squadId)
          && request.resource.data.fromUid == uid()
          && isMember(squadId, request.resource.data.toUid)
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 200
          && getAfter(/databases/$(database)/documents/squads/$(squadId)/days/$(date)/commentCounters/$(uid() + '_' + request.resource.data.toUid)).data.count <= 5;
        allow update, delete: if isSignedIn() && resource.data.fromUid == uid();
      }
      // Per-pair daily comment counter (kept in sync by the batch above).
      match /days/{date}/commentCounters/{counterId} {
        allow read: if isMemberOf(squadId);
        allow write: if isMemberOf(squadId);
      }

      // ── days/{date}/markers/{id}: function-only idempotency markers ──────────
      // (e.g. full-squad-day fired). Members may read; only the admin SDK writes.
      match /days/{date}/markers/{markerId} {
        allow read: if isMemberOf(squadId);
        allow write: if false;
      }

      // ── intentions/{week}/members/{uid}: weekly public commitments ──────────
      // Self-write only, member-read, ≤80 chars; immutable once graded.
      match /intentions/{weekKey}/members/{memberUid} {
        allow read: if isMemberOf(squadId);
        allow create, update: if isSignedIn()
          && uid() == memberUid
          && isMemberOf(squadId)
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 80
          && (resource == null
              || !('gradedStatus' in resource.data)
              || resource.data.gradedStatus == 'unset');
      }

      // ── groupGoals/{id}: shared squad goals everyone contributes to ─────────
      // Owner creates/deletes; any member may increment ONLY their own
      // contributions key (+ currentValue / hitAt).
      match /groupGoals/{goalId} {
        allow read: if isMemberOf(squadId);
        allow create: if isMemberOf(squadId)
          && isOwnerOf(squadId)
          && request.resource.data.createdBy == uid();
        allow delete: if isOwnerOf(squadId);
        allow update: if isMemberOf(squadId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contributions', 'currentValue', 'hitAt'])
          && request.resource.data.contributions.diff(resource.data.contributions).affectedKeys().hasOnly([uid()]);
      }

      // ── activity/{id}: unified squad event feed ─────────────────────────────
      // Streak losses, full-squad days, group-goal hits — written by Cloud
      // Functions (admin SDK); members read the last N for the home feed.
      match /activity/{activityId} {
        allow read: if isMemberOf(squadId);
        allow write: if false;
      }

      // ── ghostChecks/{date}/aggregateNudges/{ghostedUid}: mass-nudge batching ─
      // A member adds their own uid to nudgerUids; the coordinated push +
      // sentToGhostedAt are written by the function (admin SDK).
      match /ghostChecks/{date}/aggregateNudges/{ghostedUid} {
        allow read: if isMemberOf(squadId);
        allow create, update: if isMemberOf(squadId)
          && uid() in request.resource.data.nudgerUids; // must include self
      }

      // ── suggestions/{id}: squadmate -> me goal proposals ────────────────────
      match /suggestions/{suggestionId} {
        // A member proposes a goal to ANOTHER member of this squad.
        allow create: if isMemberOf(squadId)
          && request.resource.data.fromUid == uid()
          && request.resource.data.toUid != uid()
          && isMember(squadId, request.resource.data.toUid)
          && request.resource.data.status == 'pending';
        // Sender or recipient read. Inlined request.auth.uid so the
        // collection-group inbox query (where toUid == me) is allowed.
        allow read: if request.auth != null
          && (request.auth.uid == resource.data.fromUid
              || request.auth.uid == resource.data.toUid);
        // Recipient-only: pending -> accepted|rejected|expired; everything else
        // immutable.
        allow update: if isSignedIn()
          && uid() == resource.data.toUid
          && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'rejected', 'expired']
          && request.resource.data.fromUid == resource.data.fromUid
          && request.resource.data.toUid == resource.data.toUid
          && request.resource.data.payloadJson == resource.data.payloadJson;
        allow delete: if isSignedIn()
          && (uid() == resource.data.fromUid || uid() == resource.data.toUid);
      }
    }
  }
}
