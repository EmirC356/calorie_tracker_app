rules_version = '2';

// Firestore security rules for the Squad Accountability feature.
// Grows by phase. Phase 1 covers only the users collection; squad/day/reaction
// rules are added in Phase 2 alongside the squad model.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── users/{uid} ───────────────────────────────────────────────────────────
    // A signed-in user may read and write ONLY their own profile document
    // (displayName, photoURL, fcmTokens). Deletes are disallowed.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // ── squads/** ─────────────────────────────────────────────────────────────
    // Added in Phase 2 (membership-gated reads, owner-only squad writes,
    // self-only member/entry writes, reaction ownership, memberUids <= 10).
  }
}
