{
  "//": "'My squads' uses a single-field memberUids array-contains query and sorts by createdAt client-side. The suggestions inbox is a COLLECTION_GROUP query filtering toUid == me, status == pending, expiresAt > now, which needs the composite index below. goalsVisible's readerUids array-contains is covered by default single-field indexes.",
  "indexes": [
    {
      "collectionGroup": "suggestions",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        { "fieldPath": "toUid", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "expiresAt", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Proof: promoter sweep across all squads' pending photos.",
      "collectionGroup": "photos",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        { "fieldPath": "published", "order": "ASCENDING" },
        { "fieldPath": "deletedAt", "order": "ASCENDING" },
        { "fieldPath": "pendingPublishAt", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Proof: published photos for a squad, newest first.",
      "collectionGroup": "photos",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "published", "order": "ASCENDING" },
        { "fieldPath": "deletedAt", "order": "ASCENDING" },
        { "fieldPath": "uploadedAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Proof: my own photos (incl. pending) for a squad, newest first.",
      "collectionGroup": "photos",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "uploadedByUid", "order": "ASCENDING" },
        { "fieldPath": "deletedAt", "order": "ASCENDING" },
        { "fieldPath": "uploadedAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Proof: my reactions on a photo.",
      "collectionGroup": "photoReactions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "photoId", "order": "ASCENDING" },
        { "fieldPath": "fromUid", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Proof: reactors for one emoji on a photo.",
      "collectionGroup": "photoReactions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "photoId", "order": "ASCENDING" },
        { "fieldPath": "emoji", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
