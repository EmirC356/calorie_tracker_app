rules_version = '2';

// Firebase Storage rules for the Proof feature (instant photo sharing).
//
// Membership is enforced on the Firestore photo doc (whose storagePath points
// here), and download URLs are only discoverable through that membership-gated
// doc — so Storage itself gates on auth + the uploader tag + size/type rather
// than a cross-service firestore.get(), which was failing silently. Tolerated
// tradeoff at personal-app scale.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() { return request.auth != null; }

    match /squads/{squadId}/photos/{photoId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.auth.uid == request.resource.metadata.uploadedByUid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Generated thumbnail — signed-in read; only the Cloud Function writes.
    match /squads/{squadId}/thumbs/{photoId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Personal proof — goals shared with no squad. Strictly owner-only.
    match /users/{userId}/personalProof/{photoId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
